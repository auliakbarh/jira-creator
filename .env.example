# ─── JIRA Credentials ────────────────────────────────────────────────────────
# Dapatkan API token di: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# ─── Defaults (bisa di-override lewat flag CLI) ────────────────────────────────
JIRA_PROJECT_KEY=ENG
JIRA_DEFAULT_ISSUE_TYPE=Task
JIRA_DEFAULT_PRIORITY=Medium

# ─── AI Provider (untuk command `uac` & `epic`) ───────────────────────────────
# Pilih provider default: gemini | claude (bisa di-override lewat --provider)
AI_PROVIDER=gemini

# Google Gemini — dapatkan API key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Opsional — default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — dapatkan API key di: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
# Opsional — default: claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8
